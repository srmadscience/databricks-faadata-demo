          "rawSql": "SELECT d_category AS Category, round(try_divide(100 * count_if(ArrDel15 = 1), count_if(Cancelled = 0 AND Diverted = 0)), 1) AS `% arriving 15+ min late`,\n       round(100 * avg(Diverted), 2) AS `% diverted`,\n       round(100 * avg(Cancelled), 2) AS `% cancelled`,\n       round(avg(ArrDelay), 1) AS `Avg arrival delay`,\n       count(*) AS Flights\nFROM ${catalog}.faa.flight_weather WHERE FlightDate BETWEEN CAST($__timeFrom AS DATE) AND CAST($__timeTo AS DATE) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND d_category != ''\nGROUP BY d_category ORDER BY array_position(array('VFR', 'MVFR', 'IFR', 'LIFR'), d_category)"
