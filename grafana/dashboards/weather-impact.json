      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mullerpeter-databricks-datasource",
            "uid": "databricks-faa"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT try_divide(100 * count_if(o_category IN ('IFR', 'LIFR')), count_if(o_category != '')) FROM ${catalog}.faa.flight_weather WHERE FlightDate BETWEEN CAST($__timeFrom AS DATE) AND CAST($__timeTo AS DATE) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})"
        }
      ],
