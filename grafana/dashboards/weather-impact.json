    {
      "type": "table",
      "title": "Airport-days with the most cancellations",
      "description": "Airport-days with 50+ scheduled departures, ranked by cancellation rate, with the weather observed at departure times that day. Weather lists the most common significant conditions.",
      "datasource": {
        "type": "mullerpeter-databricks-datasource",
        "uid": "databricks-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mullerpeter-databricks-datasource",
            "uid": "databricks-faa"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- Rank airport-days cheaply first, then summarise the weather for the top 100 only.\nWITH top AS (\n    SELECT FlightDate AS day, Origin AS airport\n    FROM ${catalog}.faa.flight_weather WHERE FlightDate BETWEEN CAST($__timeFrom AS DATE) AND CAST($__timeTo AS DATE) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote})\n    GROUP BY 1, 2 HAVING count(*) >= 50\n    ORDER BY avg(Cancelled) DESC, count(*) DESC\n    LIMIT 100\n),\nf AS (\n    SELECT f.* FROM ${catalog}.faa.flight_weather AS f INNER JOIN top ON f.FlightDate = top.day AND f.Origin = top.airport\n    WHERE f.FlightDate BETWEEN CAST($__timeFrom AS DATE) AND CAST($__timeTo AS DATE) AND f.Reporting_Airline IN (${airline:singlequote}) AND f.Origin IN (${origin:singlequote})\n),\n-- the three commonest kinds of present weather, other than none\nwx AS (\n    SELECT FlightDate, Origin,\n           array_join(filter(slice(transform(array_sort(collect_list(struct(-n AS rank, o_wx))), x -> x.o_wx), 1, 3),\n                             x -> x NOT IN ('None', '')), ', ') AS Weather\n    FROM (SELECT FlightDate, Origin, o_wx, count(*) AS n FROM f GROUP BY ALL)\n    GROUP BY ALL\n)\nSELECT CAST(f.FlightDate AS STRING) AS Date, f.Origin AS Airport,\n       count(*) AS Departures,\n       round(100 * avg(Cancelled), 1) AS `Cancelled %`,\n       round(avg(DepDelay), 0) AS `Avg dep delay`,\n       round(try_divide(100 * count_if(o_category IN ('IFR', 'LIFR')), count_if(o_category != '')), 0) AS `IFR/LIFR %`,\n       any_value(wx.Weather) AS Weather,\n       round(min(o_vsby), 2) AS `Min vis (mi)`,\n       max(greatest(coalesce(o_sknt, 0), coalesce(o_gust, 0))) AS `Max wind (kt)`,\n       round(min(o_tmpf), 0) AS `Min temp (°F)`,\n       count_if(Cancelled = 1 AND CancellationCode = 'B') AS `Weather cxl`\nFROM f INNER JOIN wx ON wx.FlightDate = f.FlightDate AND wx.Origin = f.Origin\nGROUP BY f.FlightDate, f.Origin\nORDER BY `Cancelled %` DESC, Departures DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
