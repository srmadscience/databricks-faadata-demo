    {
      "type": "barchart",
      "title": "By wind at origin",
      "description": "Sustained wind or gust, whichever is higher, in knots.",
      "datasource": {
        "type": "mullerpeter-databricks-datasource",
        "uid": "databricks-faa"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mullerpeter-databricks-datasource",
            "uid": "databricks-faa"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN w < 10 THEN '0-9 kt' WHEN w < 20 THEN '10-19 kt' WHEN w < 30 THEN '20-29 kt'\n            WHEN w < 40 THEN '30-39 kt' ELSE '40+ kt' END AS Wind,\n       round(try_divide(100 * count_if(DepDel15 = 1), count_if(Cancelled = 0)), 1) AS `% departing 15+ min late`,\n       round(100 * avg(Cancelled), 2) AS `% cancelled`,\n       round(avg(DepDelay), 1) AS `Avg departure delay`,\n       count(*) AS Flights\nFROM (SELECT *, greatest(coalesce(o_sknt, 0), coalesce(o_gust, 0)) AS w\n      FROM ${catalog}.faa.flight_weather WHERE FlightDate BETWEEN CAST($__timeFrom AS DATE) AND CAST($__timeTo AS DATE) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND o_sknt IS NOT NULL)\nGROUP BY 1 ORDER BY min(w)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
