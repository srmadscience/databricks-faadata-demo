          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN o_vsby < 0.5 THEN '< 1/2 mi' WHEN o_vsby < 1 THEN '1/2-1 mi' WHEN o_vsby < 3 THEN '1-3 mi'\n            WHEN o_vsby < 6 THEN '3-5 mi' WHEN o_vsby < 10 THEN '6-9 mi' ELSE '10+ mi' END AS Visibility,\n       round(try_divide(100 * count_if(DepDel15 = 1), count_if(Cancelled = 0)), 1) AS `% departing 15+ min late`,\n       round(100 * avg(Cancelled), 2) AS `% cancelled`,\n       round(avg(DepDelay), 1) AS `Avg departure delay`,\n       count(*) AS Flights\nFROM ${catalog}.faa.flight_weather WHERE FlightDate BETWEEN CAST($__timeFrom AS DATE) AND CAST($__timeTo AS DATE) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND o_vsby IS NOT NULL\nGROUP BY 1 ORDER BY min(o_vsby)"
        }
