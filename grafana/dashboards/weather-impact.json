          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT o_wx AS Weather, round(try_divide(100 * count_if(DepDel15 = 1), count_if(Cancelled = 0)), 1) AS `% departing 15+ min late`,\n       round(100 * avg(Cancelled), 2) AS `% cancelled`,\n       round(avg(DepDelay), 1) AS `Avg departure delay`,\n       count(*) AS Flights\nFROM ${catalog}.faa.flight_weather WHERE FlightDate BETWEEN CAST($__timeFrom AS DATE) AND CAST($__timeTo AS DATE) AND Reporting_Airline IN (${airline:singlequote}) AND Origin IN (${origin:singlequote}) AND o_wx != ''\nGROUP BY o_wx ORDER BY array_position(array('None', 'Rain', 'Fog', 'Snow/ice', 'Freezing', 'Thunderstorm'), o_wx)"
