          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH t AS (SELECT make_model, month_start, flight_count FROM ${catalog}.faa.leased_plans_summary WHERE month_start BETWEEN trunc(CAST($__timeFrom AS DATE), 'MM') AND CAST($__timeTo AS DATE) AND make_model IN (${model:singlequote})),\ntop AS (SELECT make_model FROM t GROUP BY make_model ORDER BY sum(flight_count) DESC LIMIT 8)\nSELECT date_format(month_start, 'yyyy-MM') AS Month,\n       CASE WHEN make_model IN (SELECT make_model FROM top) THEN make_model ELSE 'Other' END AS Model,\n       sum(flight_count) AS Flights\nFROM t GROUP BY 1, 2 ORDER BY 1, 2"
