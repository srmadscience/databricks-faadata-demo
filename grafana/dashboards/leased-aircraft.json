          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT Tail_Number AS Tail, make_model AS Model, max(year_mfr) AS `Year built`, max(seats) AS Seats,\n       count(*) AS Months, sum(flight_count) AS Flights, sum(Maintenance) AS `Carrier cxl`, sum(Other) AS `Other cxl`,\n       round(try_divide(1000 * sum(Maintenance), sum(flight_count)), 2) AS `Carrier cxl/1k`,\n       round(try_divide(sum(sum_DepDelay), sum(OK)), 1) AS `Delay min`,\n       round(try_divide(sum(sum_Distance), sum(flight_count))) AS `Avg miles`\nFROM ${catalog}.faa.leased_plans_summary WHERE month_start BETWEEN trunc(CAST($__timeFrom AS DATE), 'MM') AND CAST($__timeTo AS DATE) AND make_model IN (${model:singlequote})\nGROUP BY Tail_Number, make_model HAVING sum(flight_count) >= ${min_flights}\nORDER BY `Carrier cxl/1k` DESC, `Delay min` DESC LIMIT 10"
