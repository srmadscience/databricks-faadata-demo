          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT make_model AS Model, count(DISTINCT Tail_Number) AS Aircraft, max(seats) AS Seats,\n       round(avg(year_mfr)) AS `Avg year built`, sum(flight_count) AS Flights,\n       round(try_divide(sum(flight_count), count(*)), 0) AS `Flts/ac-month`,\n       round(try_divide(1000 * sum(Maintenance), sum(flight_count)), 2) AS `Carrier cxl/1k`,\n       round(try_divide(1000 * sum(Other), sum(flight_count)), 2) AS `Other cxl/1k`,\n       round(try_divide(sum(sum_DepDelay), sum(OK)), 1) AS `Delay min`,\n       round(try_divide(sum(sum_Distance), sum(flight_count))) AS `Avg miles`\nFROM ${catalog}.faa.leased_plans_summary WHERE month_start BETWEEN trunc(CAST($__timeFrom AS DATE), 'MM') AND CAST($__timeTo AS DATE) AND make_model IN (${model:singlequote})\nGROUP BY make_model ORDER BY Flights DESC"
